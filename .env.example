# Copy to .env (git-ignored). Never commit real values.

# Local LLM (Ollama, OpenAI-compatible endpoint)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=

# Database. Use the limited `campaign_agent` role, not the postgres owner.
# Supabase pooler user looks like: campaign_agent.<project-ref>
DATABASE_URL=postgresql://campaign_agent.<project-ref>:<password>@<pooler-host>:6543/postgres
